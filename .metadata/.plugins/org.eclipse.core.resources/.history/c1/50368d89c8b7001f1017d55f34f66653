/* retarget.c */

#include "usart.h"    // Ensure this matches your UART handle (huart3)
#include <stdio.h>

/**
 * @brief  Retargets the C library printf function to the USART.
 * @param  file: pointer to a FILE object (unused)
 * @param  ptr: pointer to buffer to transmit
 * @param  len: number of bytes to transmit
 * @return The number of bytes written or -1 on error
 */
int _write(int file, char *ptr, int len)
{
    // Prevent unused variable warnings
    (void)file;

    // Transmit each character via USART3
    if (HAL_UART_Transmit(&huart3, (uint8_t*)ptr, len, HAL_MAX_DELAY) != HAL_OK)
    {
        return -1; // Indicate error
    }
    return len;
}
