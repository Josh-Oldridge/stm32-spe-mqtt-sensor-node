/**
  * @brief  Disable global interrupts and return previous state.
  * @retval Previous interrupt state.
  */
uint32_t HAL_INT_N_DisableIRQ(void) {
    uint32_t previous_state = __get_PRIMASK();
    __disable_irq();
    return previous_state;
}

/**
  * @brief  Enable global interrupts and return current state.
  * @retval Current interrupt state.
  */
uint32_t HAL_INT_N_EnableIRQ(void) {
    __enable_irq();
    return __get_PRIMASK();
}

