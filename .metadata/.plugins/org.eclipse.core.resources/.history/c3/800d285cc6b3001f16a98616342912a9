/**
  * @brief  Perform SPI Write and Read operations.
  * @param  pBufferTx Pointer to the transmit buffer.
  * @param  pBufferRx Pointer to the receive buffer.
  * @param  nbBytes   Number of bytes to transfer.
  * @param  useDma    Use DMA if true, else use interrupt.
  * @retval HAL_StatusTypeDef Status of the operation.
  */
HAL_StatusTypeDef HAL_SPI_Write_Read(uint8_t *pBufferTx, uint8_t *pBufferRx, uint32_t nbBytes, bool useDma)
{
    HAL_StatusTypeDef status;

    /* Assert SS. */
    HAL_GPIO_WritePin(ETH_SPI_SS_GPIO_Port, ETH_SPI_SS_Pin, GPIO_PIN_RESET);

    if (useDma)
    {
        status = HAL_SPI_TransmitReceive_DMA(&hspi1, (uint8_t *)pBufferTx, (uint8_t *)pBufferRx, nbBytes);
    }
    else
    {
        status = HAL_SPI_TransmitReceive_IT(&hspi1, (uint8_t *)pBufferTx, (uint8_t *)pBufferRx, nbBytes);
    }

    return status;
}

