/* retarget.c */

#include "usart.h"    // Ensure this matches your UART handle
#include <stdio.h>

/**
 * @brief  Retargets the C library printf function to the USART.
 * @param  file: pointer to a FILE object (unused)
 * @param  ch: character to transmit
 * @return The character written as an unsigned char cast to an int or EOF on error
 */
int _write(int file, char *ptr, int len)
{
    // Prevent unused variable warnings
    (void)file;

    // Transmit each character via UART3
    HAL_UART_Transmit(&huart3, (uint8_t*)ptr, len, HAL_MAX_DELAY);
    return len;
}
